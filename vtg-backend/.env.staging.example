# VTG staging environment template — DO NOT PUT REAL SECRETS IN THIS FILE
NODE_ENV=staging
PORT=4000

# Staging PostgreSQL
DATABASE_URL=
DATABASE_SSL=true

# Auth secrets — use unique staging-only random values
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Frontend origin
CORS_ORIGIN=https://staging.your-domain.example

# SMTP staging account/provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Object storage — use a staging bucket/prefix, never production storage
OBJECT_STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
