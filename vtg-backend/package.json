{
  "name": "vtg-africa-backend",
  "version": "1.0.0",
  "description": "Backend API for Vintage Trade Global (VTG Africa) \u2014 Africa-China trade finance platform by Folayele Global Resources Ltd (FGR)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node db/init.js",
    "db:seed": "node db/seed.js",
    "test": "node --test",
    "start:staging": "NODE_ENV=staging node src/server.js",
    "staging:health": "node scripts/staging-healthcheck.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.12.0",
    "pg-mem": "^3.0.14",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  }
}
