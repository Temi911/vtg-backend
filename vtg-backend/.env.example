# Copy this file to .env and fill in real values before running.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vtg
# Set to "true" only if your provider requires SSL (e.g. most hosted Postgres)
DATABASE_SSL=false

# JWT secrets — generate long random strings for production,
# e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of allowed origins for CORS, e.g.
# https://vtgafrica.com,https://vintageaft.vercel.app
CORS_ORIGIN=http://localhost:4000

# AI Assistant — get a key at https://console.anthropic.com/settings/keys
# The AI chat feature is disabled with a clear message until this is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Email verification SMTP (configure a real provider for inbox delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

PORT=4000
NODE_ENV=development

# Where uploaded documents are stored on disk (local dev only —
# on Vercel/serverless use S3 or similar instead, see README)
UPLOAD_DIR=./uploads


# Production object storage (S3-compatible)
OBJECT_STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
