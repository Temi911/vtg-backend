# VTG backend production environment template
# Copy to your hosting provider's environment variable panel.

NODE_ENV=production
PORT=4000

# Database
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true

# Auth secrets (generate strong random values)
JWT_ACCESS_SECRET=replace-with-64-char-random-value
JWT_REFRESH_SECRET=replace-with-another-64-char-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Frontend domain(s) allowed to call this API
CORS_ORIGIN=https://your-frontend-domain.com

# Optional AI assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Email verification SMTP (required for real email delivery)
SMTP_HOST=smtp.yourmailhost.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@yourdomain.com

# File upload location (for VM/container hosts only)
UPLOAD_DIR=./uploads


# Production object storage (S3-compatible)
OBJECT_STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
