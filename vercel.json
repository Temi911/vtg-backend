{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*\\.(js|css|png|jpg|jpeg|webp|svg|ico|woff2))",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/frontend-v3.html"
    },
    {
      "src": "^/marketplace/?$",
      "dest": "/marketplace.html"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "https://vtg-backend-production-7ad6.up.railway.app/api/$1"
    }
  ]
}
