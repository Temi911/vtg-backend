{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)\\.:ext(js|css|png|jpg|jpeg|webp|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vtg-backend-production-ab20.up.railway.app/api/:path*"
    },
    {
      "source": "/marketplace",
      "destination": "/marketplace.html"
    }
  ],
  "redirects": [
    {
      "source": "/trade-workspace.html",
      "destination": "/signin.html",
      "permanent": true
    },
    {
      "source": "/buyer-dashboard-preview.html",
      "destination": "/buyer-dashboard.html?preview=1",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/frontend-v3.html",
      "permanent": false
    }
  ]
}
