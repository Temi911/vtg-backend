{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)\\.(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/partnerships",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-partnerships"
    },
    {
      "source": "/api/admin/account-support",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-account-support/admin"
    },
    {
      "source": "/api/agent/:path*",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-inspection-workflow/agent/:path*"
    },
    {
      "source": "/api/inspections/requests/agent",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-inspection-workflow/requests/agent"
    },
    {
      "source": "/api/inspections/requests/:id/:action",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-inspection-workflow/requests/:id/:action"
    },
    {
      "source": "/api/shipment-events/:shipmentId",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-trade-operations/shipments/:shipmentId/events"
    },
    {
      "source": "/api/notifications/:path*",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-notifications/:path*"
    },
    {
      "source": "/api/notifications",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-notifications"
    },
    {
      "source": "/api/inspections/requests/:id/payment/initialize",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-inspection-payments/:id?action=initialize"
    },
    {
      "source": "/api/inspections/payment/verify",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-inspection-payments?action=verify"
    },
    {
      "source": "/api/webhooks/paystack",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-inspection-payments/webhook"
    },
    {
      "source": "/api/inspections/admin/pricing",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-inspection-workflow/admin/pricing"
    },
    {
      "source": "/api/inspections/requests",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-inspection-workflow/requests"
    },
    {
      "source": "/api/inspections/quote",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-inspection-workflow/quote"
    },
    {
      "source": "/api/inspections/mine",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-inspection-workflow/mine"
    },
    {
      "source": "/api/inspections/pricing",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-inspection-workflow/pricing"
    },
    {
      "source": "/api/marketplace/:path*",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-marketplace/:path*"
    },
    {
      "source": "/api/media/feed/:postId",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-marketplace/media/feed/:postId"
    },
    {
      "source": "/api/market-intelligence/news",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-market-intelligence/news"
    },
    {
      "source": "/api/integrations/news",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-market-intelligence/news"
    },
    {
      "source": "/api/market-intelligence/tools/contract",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-market-intelligence/tools/contract"
    },
    {
      "source": "/api/market-intelligence/tools/landed-cost/estimate",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-market-intelligence/tools/landed-cost/estimate"
    },
    {
      "source": "/api/market-intelligence/trade",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-market-intelligence/trade"
    },
    {
      "source": "/api/contact/admin/:id",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-contact-enquiries/admin/:id"
    },
    {
      "source": "/api/contact/admin",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-contact-enquiries/admin"
    },
    {
      "source": "/api/contact",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-contact-enquiries"
    },
    {
      "source": "/api/:path*",
      "destination": "https://lxrurbdzphqvkjprlfuv.supabase.co/functions/v1/vtg-api/api/:path*"
    },
    {
      "source": "/marketplace",
      "destination": "/marketplace.html"
    },
    {
      "source": "/",
      "destination": "/frontend-v3.html"
    }
  ],
  "redirects": [
    {
      "source": "/trade-workspace.html",
      "destination": "/signin.html",
      "permanent": true
    },
    {
      "source": "/buyer-dashboard-preview.html",
      "destination": "/signin.html?role=buyer&next=%2Fbuyer-dashboard.html",
      "permanent": true
    }
  ]
}
