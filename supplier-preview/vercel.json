{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vtg-backend-production-ab20.up.railway.app/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/supplier-dashboard.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\\\.(js|css|svg|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
